<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow" />

        <TextView
            style="@style/AutoPilTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="@string/app_name" />

        <TextView
            style="@style/AutoPilBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_dot"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/heardText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/heard_empty"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/confirmCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_banner"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/AutoPilEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_title"
                android:textColor="@color/wait" />

            <TextView
                android:id="@+id/confirmText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/listenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/listen" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/listen_hint" />

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:accessibilityHeading="true"
            android:text="@string/section_setup" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mic_title"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mic_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/micButton"
            style="@style/Widget.AutoPil.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mic_allow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/access_title"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/access_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accessButton"
            style="@style/Widget.AutoPil.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/access_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/contacts_title"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/contacts_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/contactsButton"
            style="@style/Widget.AutoPil.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contacts_allow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/battery_title"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/battery_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batteryButton"
            style="@style/Widget.AutoPil.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/battery_open" />

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:accessibilityHeading="true"
            android:text="@string/section_examples" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:padding="20dp"
            android:text="@string/examples"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:accessibilityHeading="true"
            android:text="@string/section_pace" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pace_body" />

        <TextView
            android:id="@+id/beforeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/beforeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/pause_before" />

        <TextView
            android:id="@+id/afterLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/afterSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/pause_after" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/continuousSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/continuous"
            android:textSize="18sp" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continuous_body" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/offlineSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="64dp"
            android:text="@string/offline"
            android:textSize="18sp" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline_body" />

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:accessibilityHeading="true"
            android:text="@string/section_manual" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/manual_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/commandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="64dp"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runCommandButton"
            style="@style/Widget.AutoPil.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/manual_run" />

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:accessibilityHeading="true"
            android:text="@string/section_log" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:text="@string/log_empty"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            style="@style/AutoPilEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:accessibilityHeading="true"
            android:text="@string/section_trust" />

        <TextView
            style="@style/AutoPilMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/trust_body" />
    </LinearLayout>
</ScrollView>
